//COMMAC   JOB (POC),'COM AND CIB DSECT NAMES',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  WHAT ARE THE DSECT NAMES GENERATED BY IEZCOM AND IEZCIB?
//*
//*  BSCFTCH FAILED WITH  "COM IS AN UNDEFINED SYMBOL"  AND  "CIB IS
//*  AN UNDEFINED SYMBOL"  ON ITS USING STATEMENTS.  NOTHING ELSE WAS
//*  FLAGGED - COMCIBPT, CIBVERB AND CIBSTOP ALL RESOLVED - SO THE
//*  FIELD NAMES ARE RIGHT AND ONLY THE DSECT NAMES ARE WRONG.
//*
//*  PRINT GEN IS ON AND NOTHING ELSE IS IN THE DECK, SO THE LISTING
//*  IS JUST THE TWO EXPANSIONS.  LOOK FOR THE  "DSECT"  STATEMENTS -
//*  WHATEVER IS IN THE NAME FIELD OF EACH ONE IS WHAT THE USING
//*  STATEMENTS IN BSCFTCH SHOULD SAY.
//*
//*  A HIGH SEVERITY CODE IS FINE; THERE IS NO CSECT HERE.
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD',
//             MAC1='SYS1.AMODGEN'
//ASM.SYSIN DD *
         PRINT ON,GEN
         IEZCOM
         IEZCIB
         END
/*

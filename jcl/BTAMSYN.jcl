//BTAMSYN  JOB (POC),'BTAM SYNTAX PROBE',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  SYNTAX PROBE - NOT A PROGRAM, IT IS NOT MEANT TO ASSEMBLE CLEAN.
//*
//*  PRINT GEN IS ON, SO EVERY MACRO THAT IS ACCEPTED SHOWS ITS FULL
//*  EXPANSION.  THE STATEMENTS THAT MNOTE ARE JUST AS USEFUL AS THE
//*  ONES THAT DO NOT - BETWEEN THEM THEY PIN DOWN THE OPERAND FORMATS
//*  THIS BTAM LEVEL ACTUALLY ACCEPTS.  EXPECT A HIGH SEVERITY CODE.
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD'
//ASM.SYSIN DD *
         PRINT ON,GEN
BTAMSYN  CSECT
         SPACE 1
*  1 - THE BSC LINE GROUP DCB, WITH THE OPERANDS I EXPECT TO NEED.
*      IF ANY OF BFTEK / CPRI / LERB IS WRONG IT WILL SAY SO.
         SPACE 1
LINEDCB  DCB   DSORG=CX,MACRF=(R,W),DEVD=BS,DDNAME=BSCLINE,            X
               BFTEK=S,CPRI=E,LERB=LERBLK
         SPACE 1
*  2 - CANDIDATE TERMINAL LIST TYPES FOR POINT TO POINT CONTENTION.
*      WHICHEVER OF THESE IS VALID IS THE ONE TO USE.
         SPACE 1
TLOPEN   DFTRMLST OPENLST
TLWRAP   DFTRMLST WRAPLST
TLONE    DFTRMLST ONETERM
         SPACE 1
*  3 - CANDIDATE READ / WRITE FORMS.  THE QUESTION IS THE OPERAND
*      ORDER - WHETHER THE TERMINAL LIST COMES BEFORE OR AFTER THE
*      AREA AND LENGTH - AND WHICH BSC OP TYPES EXIST.
         SPACE 1
         READ  DECB1,TI,LINEDCB,TLOPEN,AREA,80
         WRITE DECB2,TI,LINEDCB,TLOPEN,AREA,80
         READ  DECB3,TT,LINEDCB,TLOPEN,AREA,80
         WRITE DECB4,TT,LINEDCB,TLOPEN,AREA,80
         WRITE DECB5,TR,LINEDCB,TLOPEN,AREA,80
         SPACE 1
*  4 - WAITING FOR COMPLETION.
         SPACE 1
         TWAIT ECBLIST=ECBL
         SPACE 1
*  5 - STORAGE THE ABOVE REFERS TO.
         SPACE 1
LERBLK   DC    XL16'00'
AREA     DS    CL80
ECBL     DC    A(0)
         END
/*

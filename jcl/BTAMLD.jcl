//BTAMLD   JOB (POC),'BTAM DEVD=LD CHECK',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  THE MANUAL LISTS ONLY THREE DEVD VALUES FOR DSORG=CX - BS, WT AND
//*  LD - AND THE SWEEP CONFIRMED IT.  BS IS BISYNC, WT IS THE WORLD
//*  TRADE TELEGRAPH ADAPTER WHOSE OPEN ISSUES A X'13' THAT HERCULES
//*  COMMAND REJECTS.  THAT LEAVES LD.
//*
//*  LD IS FOR LOCALLY ATTACHED DEVICES, SO IT IS THE WRONG ANSWER FOR
//*  A REMOTE 2703 LINE.  THIS DECK ONLY ASKS ONE NARROW QUESTION -
//*  DOES IT GENERATE A COMPLETE BTAM INTERFACE?
//*
//*  WHY IT MATTERS: WHEN DEVD IS INVALID THE MACRO EMITS ONLY THE LERB
//*  AND STOPS - 56 BYTES INSTEAD OF 100, WITH NO MODE BYTE, NO
//*  MAS/CODE BYTE AND NO 26 BYTE CONTROL CHARACTER TABLE.  A DCB LIKE
//*  THAT WOULD LET BTAM WRITE PAST THE END OF ITSELF.  SO CHECK THE
//*  EXPANSION BEFORE RUNNING ANYTHING WITH IT.
//*
//*  WHAT TO LOOK FOR:  LD IS ONLY WORTH TRYING IF ITS EXPANSION SHOWS
//*  THE SAME BTAM INTERFACE FIELDS AS THE BS ONE BELOW IT -
//*      LERB / MODE / MAS,CODE / XL26 CONTROL CHARS / 4F RESERVED
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD'
//ASM.SYSIN DD *
         PRINT ON,GEN
BTAMLD   CSECT
*  THE CANDIDATE
DLD      DCB   DSORG=CX,MACRF=(R,W),DEVD=LD,DDNAME=LDLINE,             X
               BFTEK=S,LERB=LERBLK
*  THE KNOWN GOOD ONE, FOR SIDE BY SIDE COMPARISON
DBS      DCB   DSORG=CX,MACRF=(R,W),DEVD=BS,DDNAME=BSLINE,             X
               BFTEK=S,LERB=LERBLK
LERBLK   DC    XL16'00'
         END
/*

//BTAMMAC  JOB (POC),'PRINT BTAM MACROS',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  PRINT THE SOURCE OF THE TWO BTAM MACROS WHOSE OPERAND FORMAT THE
//*  PROBE COULD NOT PIN DOWN.  THE PROTOTYPE STATEMENT AND THE AIF /
//*  MNOTE VALIDATION AT THE TOP OF EACH MACRO IS THE DEFINITIVE
//*  ANSWER FOR THIS BTAM LEVEL - BETTER THAN ANY MANUAL, BECAUSE IT
//*  IS THE CODE THAT IS ACTUALLY GOING TO ASSEMBLE OUR PROGRAM.
//* ------------------------------------------------------------------
//PRINT   EXEC PGM=IEBPTPCH
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT2   DD  SYSOUT=*
//SYSIN    DD  *
  PRINT TYPORG=PO,MAXNAME=2
  MEMBER NAME=DFTRMLST
  MEMBER NAME=TWAIT
/*

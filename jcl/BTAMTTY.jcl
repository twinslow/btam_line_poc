//BTAMTTY  JOB (POC),'BTAM TTY PROBE',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  SYNTAX PROBE - NOT MEANT TO ASSEMBLE CLEAN.  EXPECT SEVERITY 12.
//*
//*  THE BTAM MACRO SYNTAX FOR THE BSC LINE IS ALREADY ESTABLISHED
//*  (SEE DOCS/BTAM-NOTES.MD).  WHAT IS NOT KNOWN FOR A START STOP
//*  TTY LINE IS
//*
//*    1. WHICH DEVD= VALUE DESCRIBES A TELEGRAPH / TTY TERMINAL
//*    2. WHICH READ / WRITE OP TYPES START STOP ACCEPTS, AND WHAT
//*       TYPE CODE EACH ONE GENERATES
//*    3. WHETHER DFTRMLST WANTS A DIFFERENT LIST TYPE
//*
//*  PRINT GEN IS ON, SO THE ACCEPTED ONES SHOW THEIR EXPANSION AND
//*  THE REJECTED ONES SHOW AN MNOTE.  BOTH ARE USEFUL.
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD'
//ASM.SYSIN DD *
         PRINT ON,GEN
BTAMTTY  CSECT
         SPACE 1
*  1 - CANDIDATE DEVD VALUES FOR A START STOP TTY LINE.
*      BS IS THE KNOWN GOOD BSC ONE AND IS HERE AS THE CONTROL - IT
*      MUST ASSEMBLE CLEAN.  ANY OTHER ONE THAT ALSO ASSEMBLES CLEAN
*      IS A CANDIDATE FOR THE TTY LINE.
         SPACE 1
DCBBS    DCB   DSORG=CX,MACRF=(R,W),DEVD=BS,DDNAME=L1,EROPT=C
DCBTT    DCB   DSORG=CX,MACRF=(R,W),DEVD=TT,DDNAME=L2,EROPT=C
DCBTW    DCB   DSORG=CX,MACRF=(R,W),DEVD=TW,DDNAME=L3,EROPT=C
DCBWU    DCB   DSORG=CX,MACRF=(R,W),DEVD=WU,DDNAME=L4,EROPT=C
DCBAT    DCB   DSORG=CX,MACRF=(R,W),DEVD=AT,DDNAME=L5,EROPT=C
DCBWT    DCB   DSORG=CX,MACRF=(R,W),DEVD=WT,DDNAME=L6,EROPT=C
DCBLT    DCB   DSORG=CX,MACRF=(R,W),DEVD=LT,DDNAME=L7,EROPT=C
DCBST    DCB   DSORG=CX,MACRF=(R,W),DEVD=ST,DDNAME=L8,EROPT=C
         SPACE 1
*  2 - CANDIDATE READ / WRITE OP TYPES.  OPERAND ORDER IS THE ONE
*      ALREADY PROVEN ON THE BSC LINE
*          DECB , TYPE , DCB , AREA , LENGTH , TERMLIST , LINENO
*      SO ANY DIAGNOSTIC HERE IS ABOUT THE TYPE, NOT THE ORDER.
*      WATCH THE 'TYPE FIELD' BYTE IN EACH EXPANSION.
         SPACE 1
         READ  RD01,TI,DCBBS,AREA,80,TRMLST,1
         READ  RD02,TT,DCBBS,AREA,80,TRMLST,1
         READ  RD03,TV,DCBBS,AREA,80,TRMLST,1
         READ  RD04,TP,DCBBS,AREA,80,TRMLST,1
         READ  RD05,TQ,DCBBS,AREA,80,TRMLST,1
         READ  RD06,TS,DCBBS,AREA,80,TRMLST,1
         SPACE 1
         WRITE WR01,TI,DCBBS,AREA,80,TRMLST,1
         WRITE WR02,TT,DCBBS,AREA,80,TRMLST,1
         WRITE WR03,TR,DCBBS,AREA,80,TRMLST,1
         WRITE WR04,TB,DCBBS,AREA,80,TRMLST,1
         WRITE WR05,TV,DCBBS,AREA,80,TRMLST,1
         WRITE WR06,TC,DCBBS,AREA,80,TRMLST,1
         SPACE 1
*  3 - TERMINAL LIST TYPES.  OPENLST IS WHAT THE BSC VERSION USES.
*      WTLIST AND WTTALST ARE IN THE MACRO'S VALID LIST AND SOUND
*      TELEGRAPH FLAVOURED, SO THEY ARE WORTH A LOOK.  EACH IS CODED
*      WITH ENOUGH OPERANDS TO CLEAR THE 'FEWER THAN TWO' CHECK.
         SPACE 1
TRMLST   DFTRMLST OPENLST,(0000)
TRMWT    DFTRMLST WTLIST,0
TRMWTTA  DFTRMLST WTTALST,0,0
         SPACE 1
AREA     DS    CL80
         END
/*

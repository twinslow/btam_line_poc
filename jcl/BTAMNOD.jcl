//BTAMNOD  JOB (POC),'BTAM NO DEVD CHECK',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  ONE GAP IS LEFT IN THE DEVD WORK.  EVERYTHING SO FAR TESTED
//*  INVALID VALUES (WHICH GET A DASD DEVICE SECTION AND A TRUNCATED
//*  BTAM INTERFACE) OR VALID ONES.  NOBODY HAS YET TRIED LEAVING DEVD
//*  OFF ALTOGETHER.
//*
//*  WHY IT MIGHT MATTER: DEVD=LD IS VALID AND STILL PRODUCES A 56 BYTE
//*  DCB - LERB AND NOTHING ELSE.  SO A SHORT DCB IS A LEGITIMATE SHAPE
//*  FOR A BTAM LINE TYPE THAT DOES NOT NEED A CONTROL CHARACTER TABLE.
//*  IF OMITTING DEVD BEHAVES LIKE LD RATHER THAN LIKE AN INVALID
//*  VALUE, THAT IS PLAUSIBLY THE ORDINARY START STOP DCB - AND THE
//*  X'13' AT OPEN WAS A WT (WORLD TRADE TELEGRAPH) ARTEFACT ONLY.
//*
//*  WHAT TO LOOK FOR IN EACH EXPANSION:
//*    ORG *+20            = THE MACRO RECOGNISED A CX LINE GROUP
//*    DC BL16'0' FDAD..   = IT FELL BACK TO THE DASD INTERFACE (BAD)
//*    HOW FAR THE BTAM INTERFACE RUNS - LERB ONLY, OR LERB THROUGH
//*    MODE / MAS,CODE / XL26 CONTROL CHARS / 4F RESERVED
//*
//*  WT IS INCLUDED WITH GEN ON BECAUSE IT HAS NEVER ACTUALLY BEEN SEEN
//*  EXPANDED - WE ONLY KNOW IT ASSEMBLES.  WORTH KNOWING WHETHER IT IS
//*  FULL LENGTH OR SHORT.
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD'
//ASM.SYSIN DD *
         PRINT ON,GEN
BTAMNOD  CSECT
*  1 - NO DEVD AT ALL.  THE ACTUAL QUESTION.
DNONE    DCB   DSORG=CX,MACRF=(R,W),DDNAME=NODEVD,BFTEK=S,             X
               LERB=LERBLK
*  2 - WT, THE WORLD TRADE TELEGRAPH ADAPTER, NEVER YET SEEN EXPANDED
DWT      DCB   DSORG=CX,MACRF=(R,W),DEVD=WT,DDNAME=WTLINE,BFTEK=S,     X
               LERB=LERBLK
*  3 - BS, THE KNOWN GOOD FULL LENGTH ONE, FOR COMPARISON
DBS      DCB   DSORG=CX,MACRF=(R,W),DEVD=BS,DDNAME=BSLINE,BFTEK=S,     X
               LERB=LERBLK
LERBLK   DC    XL16'00'
         END
/*

//APPPROBE JOB (POC),'APP MACRO PROBE',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  MACRO AVAILABILITY PROBE FOR THE BSC FETCH APPLICATION.
//*
//*  THE STARTED TASK NEEDS THREE SUBSYSTEMS WE HAVE NEVER USED ON
//*  THIS SYSTEM - VSAM, DYNAMIC ALLOCATION AND THE COMMAND INTERFACE.
//*  THIS DECK ASKS ONE QUESTION ABOUT EACH: DOES THE MACRO EXIST IN
//*  SYS1.MACLIB, AND WHAT SHAPE ARE ITS OPERANDS.
//*
//*  NOT MEANT TO ASSEMBLE CLEAN.  READ *WHICH* DIAGNOSTIC YOU GET:
//*    "UNDEFINED OP CODE"  = THE MACRO IS NOT THERE AT ALL
//*    ANY MNOTE FROM INSIDE THE MACRO = IT IS THERE AND EXPANDED,
//*                                      WHICH IS THE ANSWER WE WANT
//*
//*  PRINT NOGEN KEEPS THE OUTPUT TO THE DIAGNOSTICS.  THE MAPPING
//*  MACROS AT THE END GENERATE DSECTS, SO THEY MUST COME LAST.
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD',
//             MAC1='SYS1.AMODGEN'
//ASM.SYSIN DD *
         PRINT NOGEN
APPPROBE CSECT
         SPACE 1
         USING APPPROBE,1
*  1 - V S A M .  THE CONTROL FILE IS A KSDS READ SEQUENTIALLY AND
*      UPDATED IN PLACE, SO WE NEED ACB, RPL, OPEN, GET, PUT, ENDREQ
*      AND PROBABLY SHOWCB TO GET AT THE FEEDBACK CODE.
         SPACE 1
         GET   RPL=RPL1
         PUT   RPL=RPL1
         POINT RPL=RPL1
         ENDREQ RPL=RPL1
         SHOWCB ACB=ACB1,AREA=WORK,LENGTH=4,FIELDS=(ERROR)
         MODCB RPL=RPL1,OPTCD=(DIR)
         TESTCB ACB=ACB1,OFLAGS=OPEN
         GENCB BLK=RPL,AM=VSAM
         SPACE 1
*  2 - D Y N A M I C   A L L O C A T I O N .  SVC 99, FOR THE TEMP
*      PS DATASET AND FOR THE SYSOUT DATASET.
         SPACE 1
         DYNALLOC
         SPACE 1
*  3 - C O M M A N D   I N T E R F A C E .  FOR HANDLING MVS STOP.
*      EXTRACT GETS THE COMM AREA, QEDIT MANAGES THE CIB CHAIN.
         SPACE 1
         EXTRACT ANSWER,'S',FIELDS=(COMM)
         QEDIT ORIGIN=(1),CIBCTR=1
         SPACE 1
*  4 - T I M E R , FOR THE 60 SECOND RETRY WAIT.  EXPECTED TO BE
*      PRESENT - HERE ONLY FOR COMPLETENESS.
         SPACE 1
         STIMER WAIT,BINTVL=SIXTYSEC
         SPACE 1
*  5 - S T O R A G E   T H E   A B O V E   R E F E R S   T O
         SPACE 1
         DS    0F
ANSWER   DS    F
WORK     DS    CL60
SIXTYSEC DC    X'00000EA6'         60 SECONDS IN 1/100 SECOND UNITS
         DS    0F
ACB1     ACB   AM=VSAM,DDNAME=CTLFILE,MACRF=(KEY,SEQ,DIR,IN,OUT)
         DS    0F
RPL1     RPL   ACB=ACB1,AM=VSAM,AREA=WORK,AREALEN=60,                  X
               OPTCD=(KEY,SEQ,SYN,NUP)
         EJECT
*  6 - M A P P I N G   M A C R O S .  THESE GENERATE DSECTS SO THEY
*      COME LAST.  IEFZB4D0 AND IEFZB4D2 MAP THE SVC 99 REQUEST BLOCK
*      AND THE TEXT UNIT KEYS ; IEZCOM AND IEZCIB MAP THE COMMUNICATION
*      AREA AND THE COMMAND INPUT BUFFER.
         SPACE 1
         IEFZB4D0
         IEFZB4D2
         IEZCOM
         IEZCIB
         END
/*

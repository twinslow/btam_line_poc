//BTAMDEV  JOB (POC),'BTAM DEVD SWEEP',CLASS=A,MSGCLASS=X
//*
//* ------------------------------------------------------------------
//*  SWEEP OF DEVD= VALUES FOR DSORG=CX, USING BTAM TERMINAL TYPE
//*  MNEMONICS RATHER THAN THE TWO CHARACTER CODES OF THE FIRST PROBE.
//*
//*  WHY: THE FIRST SWEEP ONLY TRIED TWO CHARACTER VALUES AND FOUND BS
//*  AND WT.  BUT WT DRIVES THE WORLD TRADE TELEGRAPH ADAPTER, WHOSE
//*  OPEN ISSUES A X'13' THAT HERCULES COMMAND REJECTS - AND THERE IS
//*  NO WTTA LINE CONTROL IN commadpt (lnctl IS ONLY tele2 / ibm1 /
//*  bsc).  SO BS AND WT WERE PROBABLY MATCHING BSC AND WTTA, AND THE
//*  REAL NAME FOR A TELETYPE ON A TYPE II LINE IS TWX.
//*
//*  TWX IS THE ONE THAT MATTERS.  IF IT IS ACCEPTED IT SHOULD MATCH
//*  HERCULES lnctl=tele2 term=tty.  2741 IS ITS COUNTERPART FOR
//*  lnctl=ibm1 term=2741 AND IS WORTH KNOWING TOO.
//*
//*  PRINT NOGEN, SO THE ONLY OUTPUT IS THE MNOTES.  A DCB THAT DRAWS
//*  NO IHB060 IS AN ACCEPTED VALUE.  BS AND WT ARE THE KNOWN GOOD
//*  CONTROLS - IF THEY DO NOT COME BACK CLEAN, THE DECK IS WRONG.
//*
//*  EROPT IS OMITTED THROUGHOUT - CODING IT DRAWS IHB050 AND WOULD
//*  ADD NOISE TO EVERY LINE.
//* ------------------------------------------------------------------
//ASM     EXEC ASMFC,PARM.ASM='NODECK,NOLOAD'
//ASM.SYSIN DD *
         PRINT NOGEN
BTAMDEV  CSECT
*  CONTROLS - BOTH OF THESE ARE ALREADY KNOWN TO ASSEMBLE CLEAN
C01      DCB   DSORG=CX,MACRF=(R,W),DEVD=BS,DDNAME=L01
C02      DCB   DSORG=CX,MACRF=(R,W),DEVD=WT,DDNAME=L02
*
*  THE TERMINAL TYPE MNEMONICS
D01      DCB   DSORG=CX,MACRF=(R,W),DEVD=TWX,DDNAME=L03
D02      DCB   DSORG=CX,MACRF=(R,W),DEVD=WTTA,DDNAME=L04
D03      DCB   DSORG=CX,MACRF=(R,W),DEVD=BSC,DDNAME=L05
D04      DCB   DSORG=CX,MACRF=(R,W),DEVD=2741,DDNAME=L06
D05      DCB   DSORG=CX,MACRF=(R,W),DEVD=2740,DDNAME=L07
D06      DCB   DSORG=CX,MACRF=(R,W),DEVD=1050,DDNAME=L08
D07      DCB   DSORG=CX,MACRF=(R,W),DEVD=1030,DDNAME=L09
D08      DCB   DSORG=CX,MACRF=(R,W),DEVD=1060,DDNAME=L10
D09      DCB   DSORG=CX,MACRF=(R,W),DEVD=2260,DDNAME=L11
D10      DCB   DSORG=CX,MACRF=(R,W),DEVD=2265,DDNAME=L12
D11      DCB   DSORG=CX,MACRF=(R,W),DEVD=2848,DDNAME=L13
D12      DCB   DSORG=CX,MACRF=(R,W),DEVD=83B3,DDNAME=L14
D13      DCB   DSORG=CX,MACRF=(R,W),DEVD=115A,DDNAME=L15
D14      DCB   DSORG=CX,MACRF=(R,W),DEVD=AUDIO,DDNAME=L16
D15      DCB   DSORG=CX,MACRF=(R,W),DEVD=TTY,DDNAME=L17
D16      DCB   DSORG=CX,MACRF=(R,W),DEVD=TEL2,DDNAME=L18
D17      DCB   DSORG=CX,MACRF=(R,W),DEVD=TELE2,DDNAME=L19
D18      DCB   DSORG=CX,MACRF=(R,W),DEVD=IBM1,DDNAME=L20
*
*  IF TWX IS ACCEPTED, THIS ONE SHOWS ITS FULL DCB EXPANSION SO THAT
*  THE GENERATED LAYOUT CAN BE COMPARED WITH THE DEVD=BS ONE.
         PRINT GEN
DTWX     DCB   DSORG=CX,MACRF=(R,W),DEVD=TWX,DDNAME=LTWX,              X
               BFTEK=S,LERB=LERBLK
         PRINT NOGEN
LERBLK   DC    XL16'00'
         END
/*
